generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  COACH
  STUDENT
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum WorkoutStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum WeightUnit {
  KG
  LB
}

enum LengthUnit {
  CM
  IN
}

enum PercentUnit {
  PERCENT
}

enum CheckInStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum ReviewStatus {
  PENDING
  REVIEWED
}

enum UploadIntentStatus {
  PENDING
  CONSUMED
  EXPIRED
}

enum ResultAttributionMode {
  ANONYMOUS
  FIRST_NAME_INITIAL
  FULL_NAME
}

enum PublicMetricUnit {
  KG
  LB
  CM
  IN
  PERCENT
}

enum MarketingAssetKind {
  LOGO
  PORTRAIT
}

model User {
  id               String                  @id @default(cuid())
  name             String
  email            String                  @unique
  emailVerified    Boolean                 @default(false)
  image            String?
  platformRole     PlatformRole            @default(USER)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  sessions         Session[]
  accounts         Account[]
  memberships      Membership[]
  ownedWorkspaces  Workspace[]             @relation("WorkspaceOwner")
  invitationsSent  Invitation[]            @relation("InvitationSender")
  invitationsUsed  Invitation[]            @relation("InvitationAcceptor")
  auditEvents      AuditEvent[]            @relation("AuditActor")
  productEvents    ProductEvent[]
  exercisesCreated Exercise[]              @relation("ExerciseCreator")
  templatesCreated WorkoutTemplate[]       @relation("TemplateCreator")
  plansCreated     WorkoutPlan[]           @relation("PlanCreator")
  planAssignments  StudentPlanAssignment[] @relation("PlanAssigner")
  workoutSessions  WorkoutSession[]
  measurementCheckIns MeasurementCheckIn[] @relation("CheckInStudent")
  progressPhotos   ProgressPhoto[]          @relation("PhotoStudent")
  reviewNotes      ReviewNote[]             @relation("ReviewCoach")
  reviewReplies    ReviewReply[]            @relation("ReviewReplyStudent")
  photoUploadIntents PhotoUploadIntent[]    @relation("UploadIntentStudent")
  landingRevisionsCreated     CoachLandingRevision[]      @relation("LandingRevisionCreator")
  resultStoriesCreated        StudentResultStory[]        @relation("ResultStoryCreator")
  resultVersionsCreated       StudentResultVersion[]      @relation("ResultVersionCreator")
  resultApprovalsAsStudent    StudentResultApproval[]     @relation("ResultApprovalStudent")
  marketingUploadIntentsCreated MarketingAssetUploadIntent[] @relation("MarketingUploadCreator")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Workspace {
  id               String                  @id @default(cuid())
  slug             String                  @unique
  name             String
  timeZone         String                  @default("America/Mexico_City")
  ownerId          String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  owner            User                    @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships      Membership[]
  invitations      Invitation[]
  auditEvents      AuditEvent[]
  productEvents    ProductEvent[]
  exercises        Exercise[]
  workoutTemplates WorkoutTemplate[]
  workoutPlans     WorkoutPlan[]
  planAssignments  StudentPlanAssignment[]
  assignedWorkouts AssignedWorkout[]
  measurementCheckIns MeasurementCheckIn[]
  progressPhotos   ProgressPhoto[]
  reviewNotes      ReviewNote[]
  reviewReplies    ReviewReply[]
  photoUploadIntents PhotoUploadIntent[]
  coachLanding             CoachLanding?
  resultStories            StudentResultStory[]
  marketingAssetUploadIntents MarketingAssetUploadIntent[]
  marketingAssets          MarketingAsset[]
  publicLandingMetricsDaily PublicLandingMetricDaily[]

  @@index([ownerId])
}

model Membership {
  id              String                  @id @default(cuid())
  workspaceId     String
  userId          String
  role            MembershipRole
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  workspace       Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  planAssignments StudentPlanAssignment[] @relation("AssignedStudentMembership")
  resultStories   StudentResultStory[]     @relation("ResultStoryStudentMembership")
  resultApprovals StudentResultApproval[]  @relation("ResultApprovalStudentMembership")

  @@unique([workspaceId, userId])
  @@unique([id, workspaceId])
  @@index([userId])
}

model Invitation {
  id           String         @id @default(cuid())
  workspaceId  String
  invitedById  String
  acceptedById String?
  tokenHash    String         @unique
  role         MembershipRole @default(STUDENT)
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User           @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?          @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([expiresAt])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  dedupeKey   String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@unique([workspaceId, dedupeKey])
}

model ProductEvent {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  name        String
  properties  Json?
  createdAt   DateTime  @default(now())
  dedupeKey   String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@unique([workspaceId, dedupeKey])
}

model Exercise {
  id                String             @id @default(cuid())
  workspaceId       String
  createdById       String
  name              String
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         User               @relation("ExerciseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  templateExercises TemplateExercise[]

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model WorkoutTemplate {
  id           String             @id @default(cuid())
  workspaceId  String
  createdById  String
  name         String
  description  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  exercises    TemplateExercise[]
  planWorkouts PlanWorkout[]

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model TemplateExercise {
  id             String          @id @default(cuid())
  templateId     String
  exerciseId     String
  order          Int
  prescribedSets Int
  repMin         Int
  repMax         Int
  targetRpe      Decimal?        @db.Decimal(3, 1)
  restSeconds    Int?
  notes          String?
  template       WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise       Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([templateId, order])
  @@index([exerciseId])
}

model WorkoutPlan {
  id          String                  @id @default(cuid())
  workspaceId String
  createdById String
  name        String
  startsOn    DateTime                @db.Date
  endsOn      DateTime                @db.Date
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User                    @relation("PlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  workouts    PlanWorkout[]
  assignments StudentPlanAssignment[]

  @@index([workspaceId, startsOn])
}

model PlanWorkout {
  id               String            @id @default(cuid())
  planId           String
  templateId       String
  order            Int
  scheduledOn      DateTime          @db.Date
  plan             WorkoutPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  template         WorkoutTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  assignedWorkouts AssignedWorkout[]

  @@unique([planId, order])
  @@index([templateId])
  @@index([scheduledOn])
}

model StudentPlanAssignment {
  id                  String            @id @default(cuid())
  workspaceId         String
  planId              String
  studentMembershipId String
  assignedById        String
  assignedAt          DateTime          @default(now())
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                WorkoutPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  studentMembership   Membership        @relation("AssignedStudentMembership", fields: [studentMembershipId], references: [id], onDelete: Restrict)
  assignedBy          User              @relation("PlanAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  workouts            AssignedWorkout[]

  @@index([workspaceId, assignedAt])
  @@index([studentMembershipId, assignedAt])
  @@unique([workspaceId, planId, studentMembershipId])
}

model AssignedWorkout {
  id               String                @id @default(cuid())
  workspaceId      String
  assignmentId     String
  planWorkoutId    String
  sourceTemplateId String
  studentId        String
  templateName     String
  scheduledOn      DateTime              @db.Date
  status           WorkoutStatus         @default(PLANNED)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignment       StudentPlanAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  planWorkout      PlanWorkout           @relation(fields: [planWorkoutId], references: [id], onDelete: Restrict)
  exercises        AssignedExercise[]
  session          WorkoutSession?

  @@index([workspaceId, studentId, scheduledOn])
  @@index([assignmentId])
}

model AssignedExercise {
  id                String          @id @default(cuid())
  assignedWorkoutId String
  sourceExerciseId  String
  exerciseName      String
  order             Int
  prescribedSets    Int
  repMin            Int
  repMax            Int
  targetRpe         Decimal?        @db.Decimal(3, 1)
  restSeconds       Int?
  notes             String?
  assignedWorkout   AssignedWorkout @relation(fields: [assignedWorkoutId], references: [id], onDelete: Cascade)
  exerciseLogs      ExerciseLog[]

  @@unique([assignedWorkoutId, order])
}

model WorkoutSession {
  id                String          @id @default(cuid())
  assignedWorkoutId String          @unique
  studentId         String
  status            WorkoutStatus   @default(IN_PROGRESS)
  startedAt         DateTime        @default(now())
  completedAt       DateTime?
  updatedAt         DateTime        @updatedAt
  reviewStatus      ReviewStatus    @default(PENDING)
  reviewedAt        DateTime?
  assignedWorkout   AssignedWorkout @relation(fields: [assignedWorkoutId], references: [id], onDelete: Cascade)
  student           User            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  exerciseLogs      ExerciseLog[]
  reviewNotes       ReviewNote[]

  @@index([studentId, startedAt])
}

model MeasurementCheckIn {
  id                   String        @id @default(cuid())
  workspaceId          String
  studentId            String
  status               CheckInStatus @default(DRAFT)
  reviewStatus         ReviewStatus  @default(PENDING)
  weight               Decimal?      @db.Decimal(8, 2)
  weightUnit           WeightUnit?
  bodyFat              Decimal?      @db.Decimal(5, 2)
  bodyFatUnit          PercentUnit?
  chest                Decimal?      @db.Decimal(8, 2)
  chestUnit            LengthUnit?
  waist                Decimal?      @db.Decimal(8, 2)
  waistUnit            LengthUnit?
  hips                 Decimal?      @db.Decimal(8, 2)
  hipsUnit             LengthUnit?
  arm                  Decimal?      @db.Decimal(8, 2)
  armUnit              LengthUnit?
  thigh                Decimal?      @db.Decimal(8, 2)
  thighUnit            LengthUnit?
  notes                String?
  submitIdempotencyKey String?
  draftSlot            String?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student              User          @relation("CheckInStudent", fields: [studentId], references: [id], onDelete: Restrict)
  photos               ProgressPhoto[]
  uploadIntents        PhotoUploadIntent[]
  reviewNotes          ReviewNote[]

  @@index([workspaceId, studentId, createdAt])
  @@index([workspaceId, reviewStatus, submittedAt])
  @@unique([workspaceId, submitIdempotencyKey])
  @@unique([workspaceId, studentId, draftSlot])
}

model PhotoUploadIntent {
  id             String             @id @default(cuid())
  workspaceId    String
  studentId      String
  checkInId      String
  idempotencyKey String
  objectKey      String             @unique
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  expiresAt      DateTime
  status         UploadIntentStatus @default(PENDING)
  consumedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student        User               @relation("UploadIntentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  checkIn        MeasurementCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  photo          ProgressPhoto?

  @@index([workspaceId, studentId, status])
  @@unique([workspaceId, idempotencyKey])
}

model ProgressPhoto {
  id             String             @id @default(cuid())
  workspaceId    String
  studentId      String
  checkInId      String
  objectKey      String             @unique
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  idempotencyKey String
  uploadIntentId String             @unique
  createdAt      DateTime           @default(now())
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student        User               @relation("PhotoStudent", fields: [studentId], references: [id], onDelete: Restrict)
  checkIn        MeasurementCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  uploadIntent   PhotoUploadIntent  @relation(fields: [uploadIntentId], references: [id], onDelete: Restrict)

  @@index([workspaceId, studentId, createdAt])
  @@unique([workspaceId, idempotencyKey])
}

model ReviewNote {
  id             String              @id @default(cuid())
  workspaceId    String
  coachId        String
  checkInId      String?
  workoutSessionId String?
  body           String
  idempotencyKey String
  createdAt      DateTime            @default(now())
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  coach          User                @relation("ReviewCoach", fields: [coachId], references: [id], onDelete: Restrict)
  checkIn        MeasurementCheckIn? @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  workoutSession WorkoutSession?     @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  reply          ReviewReply?

  @@index([workspaceId, createdAt])
  @@index([checkInId])
  @@index([workoutSessionId])
  @@unique([workspaceId, idempotencyKey])
}

model ReviewReply {
  id           String     @id @default(cuid())
  workspaceId  String
  reviewNoteId String     @unique
  studentId    String
  body         String
  createdAt    DateTime   @default(now())
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reviewNote   ReviewNote @relation(fields: [reviewNoteId], references: [id], onDelete: Cascade)
  student      User       @relation("ReviewReplyStudent", fields: [studentId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([studentId, createdAt])
}

model ExerciseLog {
  id                 String           @id @default(cuid())
  sessionId          String
  assignedExerciseId String
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  session            WorkoutSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignedExercise   AssignedExercise @relation(fields: [assignedExerciseId], references: [id], onDelete: Restrict)
  sets               SetLog[]

  @@unique([sessionId, assignedExerciseId])
}

model SetLog {
  id            String      @id @default(cuid())
  exerciseLogId String
  setNumber     Int
  reps          Int
  weight        Decimal     @db.Decimal(8, 2)
  unit          WeightUnit
  rpe           Decimal?    @db.Decimal(3, 1)
  completed     Boolean     @default(false)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)

  @@unique([exerciseLogId, setNumber])
}

// --- Marketing module: workspace coach landing page (docs/PLAN-landing.md) ---

model CoachLanding {
  id                     String                @id @default(cuid())
  workspaceId            String                @unique
  currentDraftRevisionId String?               @unique
  publishedRevisionId    String?               @unique
  publishedAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  workspace              Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  revisions              CoachLandingRevision[] @relation("LandingRevisions")
  currentDraftRevision   CoachLandingRevision? @relation("LandingCurrentDraft", fields: [currentDraftRevisionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  publishedRevision      CoachLandingRevision? @relation("LandingPublishedRevision", fields: [publishedRevisionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([id, workspaceId])
  @@unique([currentDraftRevisionId, workspaceId])
  @@unique([publishedRevisionId, workspaceId])
}

model CoachLandingRevision {
  id               String    @id @default(cuid())
  workspaceId      String
  landingId        String
  revisionNumber   Int
  themeKey         String
  createdById      String
  mutationKey      String
  payloadHash      String
  coachDisplayName String
  heroEyebrow      String?
  heroHeadline     String
  heroSubheadline  String
  valueProposition String?
  servicesHeading     String?
  methodologyHeading  String?
  resultsHeading      String?
  aboutHeading     String?
  aboutBody        String?
  faqHeading       String?
  ctaHeading       String
  ctaBody          String?
  whatsappDigits   String
  whatsappMessage  String
  instagramUrl     String?
  publicEmail      String?
  seoTitle         String?
  seoDescription   String?
  logoAssetId      String?
  portraitAssetId  String?
  createdAt        DateTime  @default(now())
  landing          CoachLanding @relation("LandingRevisions", fields: [landingId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  draftFor         CoachLanding? @relation("LandingCurrentDraft")
  publishedFor     CoachLanding? @relation("LandingPublishedRevision")
  createdBy        User      @relation("LandingRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  logoAsset        MarketingAsset? @relation("LandingRevisionLogo", fields: [logoAssetId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  portraitAsset    MarketingAsset? @relation("LandingRevisionPortrait", fields: [portraitAssetId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  credibilityFacts LandingCredibilityFact[]
  programs         LandingProgram[]
  methodSteps      LandingMethodStep[]
  faqs             LandingFaq[]
  resultSelections LandingRevisionResult[]
  metricsDaily     PublicLandingMetricDaily[]

  @@unique([landingId, revisionNumber])
  @@unique([workspaceId, mutationKey])
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
}

model LandingCredibilityFact {
  id         String               @id @default(cuid())
  revisionId String
  order      Int
  label      String
  value      String
  revision   CoachLandingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, order])
}

model LandingProgram {
  id          String               @id @default(cuid())
  revisionId  String
  order       Int
  title       String
  description String
  revision    CoachLandingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, order])
}

model LandingMethodStep {
  id          String               @id @default(cuid())
  revisionId  String
  order       Int
  title       String
  description String
  revision    CoachLandingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, order])
}

model LandingFaq {
  id         String               @id @default(cuid())
  revisionId String
  order      Int
  question   String
  answer     String
  revision   CoachLandingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, order])
}

model LandingRevisionResult {
  id              String               @id @default(cuid())
  workspaceId     String
  revisionId      String
  order           Int
  resultVersionId String
  revision        CoachLandingRevision @relation(fields: [revisionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  resultVersion   StudentResultVersion @relation(fields: [resultVersionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([revisionId, order])
  @@unique([revisionId, resultVersionId])
}

model StudentResultStory {
  id                  String                @id @default(cuid())
  workspaceId         String
  studentMembershipId String
  createdById         String
  currentVersionId    String?               @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  studentMembership   Membership            @relation("ResultStoryStudentMembership", fields: [studentMembershipId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdBy           User                  @relation("ResultStoryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions            StudentResultVersion[] @relation("StoryVersions")
  currentVersion      StudentResultVersion? @relation("StoryCurrentVersion", fields: [currentVersionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([id, workspaceId])
  @@unique([currentVersionId, workspaceId])
  @@index([workspaceId, studentMembershipId])
}

model StudentResultVersion {
  id               String              @id @default(cuid())
  workspaceId      String
  storyId          String
  versionNumber    Int
  createdById      String
  headline         String
  narrative        String?
  testimonial      String?
  attributionMode  ResultAttributionMode @default(ANONYMOUS)
  attributionLabel String
  requestedAt      DateTime            @default(now())
  supersededAt     DateTime?
  mutationKey      String
  payloadHash      String
  createdAt        DateTime            @default(now())
  story            StudentResultStory  @relation("StoryVersions", fields: [storyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  currentFor       StudentResultStory? @relation("StoryCurrentVersion")
  createdBy        User                @relation("ResultVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  metrics          StudentResultMetricSnapshot[]
  approval         StudentResultApproval?
  landingSelections LandingRevisionResult[]

  @@unique([storyId, versionNumber])
  @@unique([workspaceId, mutationKey])
  @@unique([id, workspaceId])
  @@index([workspaceId, storyId])
}

model StudentResultMetricSnapshot {
  id              String               @id @default(cuid())
  workspaceId     String
  resultVersionId String
  label           String
  beforeValue     Decimal              @db.Decimal(10, 2)
  afterValue      Decimal              @db.Decimal(10, 2)
  unit            PublicMetricUnit
  order           Int
  resultVersion   StudentResultVersion @relation(fields: [resultVersionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([resultVersionId, order])
}

model StudentResultApproval {
  id                 String               @id @default(cuid())
  workspaceId        String
  resultVersionId    String               @unique
  studentId          String
  approvedFingerprint String
  approvedAt         DateTime             @default(now())
  revokedAt          DateTime?
  approveMutationKey String
  revokeMutationKey  String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  resultVersion      StudentResultVersion @relation(fields: [resultVersionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  student            User                 @relation("ResultApprovalStudent", fields: [studentId], references: [id], onDelete: Restrict)
  /// Enforces same-workspace membership; the STUDENT role check belongs to the Batch 4 transactional command.
  studentMembership  Membership           @relation("ResultApprovalStudentMembership", fields: [workspaceId, studentId], references: [workspaceId, userId], onDelete: Restrict)

  @@unique([workspaceId, approveMutationKey])
  @@unique([resultVersionId, workspaceId])
}

model MarketingAssetUploadIntent {
  id             String             @id @default(cuid())
  workspaceId    String
  createdById    String
  kind           MarketingAssetKind
  idempotencyKey String
  objectKey      String             @unique
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  expiresAt      DateTime
  status         UploadIntentStatus @default(PENDING)
  consumedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User               @relation("MarketingUploadCreator", fields: [createdById], references: [id], onDelete: Restrict)
  asset          MarketingAsset?

  @@index([workspaceId, createdById, status])
  @@unique([workspaceId, idempotencyKey])
  @@unique([id, workspaceId])
}

model MarketingAsset {
  id             String                      @id @default(cuid())
  workspaceId    String
  kind           MarketingAssetKind
  objectKey      String                      @unique
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  idempotencyKey String
  uploadIntentId String                      @unique
  createdAt      DateTime                    @default(now())
  workspace      Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadIntent   MarketingAssetUploadIntent  @relation(fields: [uploadIntentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  revisionsAsLogo     CoachLandingRevision[] @relation("LandingRevisionLogo")
  revisionsAsPortrait CoachLandingRevision[] @relation("LandingRevisionPortrait")

  @@unique([workspaceId, idempotencyKey])
  @@unique([id, workspaceId])
  @@unique([uploadIntentId, workspaceId])
  @@index([workspaceId, kind])
}

model PublicLandingMetricDaily {
  id                  String               @id @default(cuid())
  workspaceId         String
  publishedRevisionId String
  day                 DateTime             @db.Date
  views               Int                  @default(0)
  whatsappClicks      Int                  @default(0)
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  revision            CoachLandingRevision @relation(fields: [publishedRevisionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([workspaceId, publishedRevisionId, day])
}
